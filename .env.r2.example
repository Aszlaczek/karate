# Wzór lokalnego pliku sekretów R2.
# Skopiuj do .env.r2 i uzupełnij; .env.r2 jest gitignored.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev/

# Opcjonalnie: inna ścieżka pliku sekretów dla skryptów (domyślnie .env.r2).
# R2_ENV_FILE=.env.r2.moj
