{
  "name": "web-karate",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "audit": "node scripts/audit-danych.mjs",
    "media:manifest": "node scripts/generate-media.mjs",
    "media:check": "node scripts/audit-danych.mjs",
    "media:organize": "node scripts/organize-media.mjs",
    "media:prepare": "node scripts/prepare-media.mjs",
    "media:upload": "node scripts/upload-media.mjs",
    "media:check-remote": "node scripts/check-remote-media.mjs",
    "media:cleanup": "node scripts/cleanup-media.mjs",
