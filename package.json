    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.0",
